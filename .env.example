# Required: token from https://t.me/BotFather. Never commit your .env.
BOT_TOKEN=
DATA_DIR=./data
# Admins enroll each supergroup with /setup, then /mode enforce.
DEFAULT_MODE=observe
MAX_GROUPS=1000
MAX_TRACKED_USERS=50000
STATE_TTL_SECONDS=900
USER_CAPACITY=20
USER_REFILL_PER_SECOND=1
VC_CAPACITY=24
VC_REFILL_PER_SECOND=4
CHAT_CAPACITY=80
CHAT_REFILL_PER_SECOND=10
THREAT_THRESHOLD=65
RESTRICTION_SECONDS=180
CAPTCHA_SECONDS=180
RETENTION_DAYS=7
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
# Optional: at least 32 characters. Protects /metrics; blank disables metrics.
METRICS_TOKEN=
# Optional direct VC adapter: real USER session, not the bot token.
MT_ENABLED=false
MT_API_ID=
MT_API_HASH=
MT_SESSION_FILE=./.secrets/mtproto.session
# Explicit group allowlist for the account. /vc on is also required in each group.
# Format: comma-separated numeric supergroup IDs from /status.
MT_ALLOWED_CHATS=
# VC mute lasts until group admin manually reverses it. No automatic unmute.
# The bot NEVER claims to block UDP at Telegram's network perimeter.
