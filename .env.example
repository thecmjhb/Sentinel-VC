# Required: YOUR OWN bot token from https://t.me/BotFather, not @sentinelvcbot's token. Never commit your .env.
BOT_TOKEN=
DATA_DIR=./data
# Admins enroll public/private supergroups and channels in the bot private /communities panel.
DEFAULT_MODE=observe
MAX_GROUPS=1000
MAX_TRACKED_USERS=50000
STATE_TTL_SECONDS=900
USER_CAPACITY=20
USER_REFILL_PER_SECOND=1
VC_CAPACITY=24
VC_REFILL_PER_SECOND=4
# Collective call-state join burst (not packet telemetry). Per-community Raid shield opt-in required.
VC_RAID_WINDOW_SECONDS=10
VC_RAID_UNIQUE_JOINS=12
VC_RAID_BASELINE_MULTIPLIER=3
CHAT_CAPACITY=80
CHAT_REFILL_PER_SECOND=10
THREAT_THRESHOLD=65
RESTRICTION_SECONDS=180
CAPTCHA_SECONDS=180
RETENTION_DAYS=7
HTTP_HOST=127.0.0.1
# VPS health-check port (Docker host mapping, or direct Node.js listener).
# Choose an available port; setup.sh prompts for this. No public firewall rule needed.
HTTP_PORT=18765
# Optional: at least 32 characters. Protects /metrics; blank disables metrics.
METRICS_TOKEN=
# Optional direct VC adapter: real USER session, not the bot token.
MT_ENABLED=false
# Bot-private QR account connection (separate from the optional local operator session).
# Run: bash scripts/voice-setup.sh --qr, then restart. Each admin connects their own account.
MT_QR_ENABLED=false
# 32 random bytes as 64 hex characters, generated by the QR setup wizard. Keep it private/backed up.
MT_SESSION_KEY=
MT_MAX_ACCOUNTS=20
MT_API_ID=
MT_API_HASH=
MT_SESSION_FILE=./.secrets/mtproto.session
# Explicit group/channel allowlist for the user account; enable Voice controls privately in each community.
# Format: comma-separated numeric supergroup/channel IDs from the /communities panel.
MT_ALLOWED_CHATS=
# VC mute lasts until group admin manually reverses it. No automatic unmute.
# The bot NEVER claims to block UDP at Telegram's network perimeter.
